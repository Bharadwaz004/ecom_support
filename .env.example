# Copy to .env and fill in. app/config.py validates these at startup and exits with a list
# of everything missing. Only HF_TOKEN and QDRANT_URL are required; the rest have defaults.

# --- LLM (Hugging Face Inference Providers, OpenAI-compatible router) ---------------
# REQUIRED. Create at https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission - a plain read token is not enough.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible base URL. Swap this and LLM_MODEL to change provider, no code change.
LLM_BASE_URL=https://router.huggingface.co/v1

# Must support tool calling, or the agent loop cannot call any tool.
# Alternatives that work: meta-llama/Llama-3.3-70B-Instruct, mistralai/Mistral-Small-24B-Instruct-2501.
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Embeddings ---------------------------------------------------------------------
# The SAME model must be used by scripts/index_docs.py (locally, via sentence-transformers)
# and by app/rag.py (at runtime, via the HF API), or the vectors are not comparable.
# app/rag.py asserts the dimension matches the Qdrant collection at startup.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional. The OpenAI-compatible router above has no feature-extraction route, so query
# embedding uses the hf-inference pipeline host instead. The final URL is
# <EMBED_BASE_URL>/<EMBED_MODEL>/pipeline/feature-extraction.
EMBED_BASE_URL=https://router.huggingface.co/hf-inference/models

# --- Qdrant Cloud (free tier) --------------------------------------------------------
# REQUIRED. Include the port. Free 1GB cluster at https://cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=desicart_policies

# --- App -----------------------------------------------------------------------------
# The agent's MCP client dials this; it is this same process's /mcp mount.
# Keep the trailing slash - without it every MCP request costs an extra 307 redirect.
# The Dockerfile derives this from $PORT automatically, so leave it unset in production.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp/

# Relative paths resolve against the repo root, not the working directory.
DB_PATH=data/orders.db

# --- Limits --------------------------------------------------------------------------
# Both are rolling windows held in memory. No Redis, and they reset when the app restarts.
DAILY_MESSAGE_CAP=500
PER_IP_HOURLY_CAP=10

# Tool-calling rounds before the agent is forced to answer from what it has.
MAX_TOOL_ROUNDS=4

# Prior conversation turns replayed to the model for follow-up questions. The client sends
# the history, so the server keeps no session state; this bounds how much it will trust.
MAX_HISTORY_TURNS=6

# Seconds before an LLM, embedding or Qdrant call is abandoned.
REQUEST_TIMEOUT_S=60
